<?xml version="1.0" encoding="UTF-8"?>
<!--
  COMMON logback config for ALL microservices.
  Nothing service-specific is hardcoded: every value comes from Spring
  properties (application.properties + <service>.properties) with safe defaults.
  Logger levels are NOT set here - use logging.level.* in properties.
-->
<configuration>

	<springProperty scope="context" name="APP_NAME"       source="spring.application.name"   defaultValue="application" />
	<springProperty scope="context" name="LOG_DIR"        source="app.logging.dir"           defaultValue="microservice-logs" />
	<springProperty scope="context" name="LOG_FILE_NAME"  source="app.logging.file-name"     defaultValue="application" />
	<springProperty scope="context" name="MAX_FILE_SIZE"  source="app.logging.max-file-size" defaultValue="10MB" />
	<springProperty scope="context" name="MAX_HISTORY"    source="app.logging.max-history"   defaultValue="30" />
	<springProperty scope="context" name="TOTAL_SIZE_CAP" source="app.logging.total-size-cap" defaultValue="1GB" />
	<springProperty scope="context" name="LOG_PATTERN"    source="app.logging.pattern"
		defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:-},%X{spanId:-}] %logger{36} - %msg%n" />

	<!-- Console logging -->
	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>${LOG_PATTERN}</pattern>
		</encoder>
	</appender>

	<!-- File logging: daily + size based rolling -->
	<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR}/${LOG_FILE_NAME}.log</file>

		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_DIR}/${LOG_FILE_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
			<maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
			<maxHistory>${MAX_HISTORY}</maxHistory>
			<totalSizeCap>${TOTAL_SIZE_CAP}</totalSizeCap>
		</rollingPolicy>

		<encoder>
			<pattern>${LOG_PATTERN}</pattern>
		</encoder>
	</appender>

	<!-- Root level comes from logging.level.root (Spring Boot applies it on top) -->
	<root level="INFO">
		<appender-ref ref="CONSOLE" />
		<appender-ref ref="FILE" />
	</root>

</configuration>
